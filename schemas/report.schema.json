{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rar-installer-troubleshooter:report:1",
  "title": "Deterministic RAPP Roadside diagnosis",
  "description": "Customer support result with a RAPP Pit Crew maintainer handoff. The retained schema string is a compatibility protocol ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "support_system",
    "machine_issue_artifact",
    "case_id",
    "platform",
    "target",
    "invariants",
    "privacy",
    "observation_summary",
    "evidence_partition",
    "platform_policy_unknowns",
    "byte_bindings",
    "replay_manifest",
    "report_controls",
    "scaling",
    "release_readiness",
    "closed_loop",
    "finding",
    "issue_signature",
    "next_action",
    "retest",
    "maintainer_handoff",
    "report_id"
  ],
  "properties": {
    "schema": {
      "const": "rar-installer-troubleshooter/report-1"
    },
    "issue_signature": {
      "$ref": "issue-signature.schema.json"
    },
    "support_system": {
      "const": "RAPP Roadside"
    },
    "machine_issue_artifact": {
      "const": "Roadside Frame"
    },
    "case_id": {
      "type": "string"
    },
    "platform": {
      "enum": [
        "linux",
        "macos",
        "windows"
      ]
    },
    "target": {
      "type": "object"
    },
    "invariants": {
      "type": "object"
    },
    "privacy": {
      "type": "object"
    },
    "observation_summary": {
      "type": "object"
    },
    "evidence_partition": {
      "type": "object",
      "required": [
        "observed",
        "inferred",
        "raw_reporting_ai_text_or_logs_retained",
        "embedded_instructions_executed"
      ],
      "properties": {
        "raw_reporting_ai_text_or_logs_retained": {
          "const": false
        },
        "embedded_instructions_executed": {
          "const": false
        }
      }
    },
    "platform_policy_unknowns": {
      "type": "object"
    },
    "byte_bindings": {
      "type": "object"
    },
    "replay_manifest": {
      "type": "object"
    },
    "report_controls": {
      "type": "object"
    },
    "scaling": {
      "type": "object",
      "required": [
        "claim",
        "unbounded_or_infinite_claim",
        "global_lock",
        "global_raw_data_store",
        "measured_backpressure"
      ],
      "properties": {
        "claim": {
          "const": "horizontal-cellular-scaling"
        },
        "unbounded_or_infinite_claim": {
          "const": false
        },
        "global_lock": {
          "const": false
        },
        "global_raw_data_store": {
          "const": false
        }
      }
    },
    "release_readiness": {
      "type": "object"
    },
    "closed_loop": {
      "type": "object",
      "required": [
        "contract",
        "name",
        "customer_state",
        "next_bounded_action",
        "repair_requires_human_approval",
        "share_with_kody_inert",
        "roadside_frame_embedded",
        "automatic_actions"
      ],
      "properties": {
        "contract": {
          "const": "rapp/closed-loop.json"
        },
        "name": {
          "const": "RAPP Roadside Closed Loop"
        },
        "share_with_kody_inert": {
          "const": true
        },
        "roadside_frame_embedded": {
          "const": true
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "summary"
      ]
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "reason",
        "command_argv",
        "timeout_seconds",
        "writes",
        "expected",
        "alternatives"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "command_argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "retest": {
      "type": "object",
      "required": [
        "mode",
        "assertions"
      ]
    },
    "maintainer_handoff": {
      "type": "object",
      "required": [
        "system"
      ],
      "properties": {
        "system": {
          "const": "RAPP Pit Crew"
        }
      }
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
