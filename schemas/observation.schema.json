{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rar-installer-troubleshooter:observation:1",
  "title": "Sanitized RAPP Roadside setup observation",
  "description": "On-device support observation; the retained URN is a compatibility protocol ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "platform",
    "setup_elapsed_seconds",
    "setup_stage",
    "source",
    "launcher",
    "python",
    "health",
    "chat",
    "installers",
    "repository",
    "safety"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "platform": {
      "enum": [
        "linux",
        "macos",
        "windows"
      ]
    },
    "failure_code": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "signature_phase": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "signature_input_hashes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "probe_url": {
      "type": "string",
      "pattern": "^http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]+)?(?:/.*)?$"
    },
    "setup_elapsed_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "setup_stage": {
      "enum": [
        "agent-dependency-install",
        "creating-venv",
        "installing-requirements",
        "ready",
        "starting-server",
        "unknown"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "executable"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^3\\.[0-9]+(?:\\.[0-9]+)?$"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "http_status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-probed",
            "ok",
            "pending",
            "starting",
            "unknown",
            "unreachable"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "request_field",
        "http_status",
        "response_keys"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "request_field": {
          "type": "string"
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "response_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "installers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docs_mirrors_match"
      ],
      "properties": {
        "docs_mirrors_match": {
          "type": "boolean"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_main_change_requested"
      ],
      "properties": {
        "direct_main_change_requested": {
          "type": "boolean"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_network_observed",
        "grail_modified"
      ],
      "properties": {
        "external_network_observed": {
          "type": "boolean"
        },
        "grail_modified": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "certificate_state",
        "clock_state",
        "filesystem",
        "locale",
        "managed_policy",
        "os_build",
        "proxy_state",
        "security_product_state",
        "shell"
      ],
      "properties": {
        "architecture": {
          "type": "string"
        },
        "certificate_state": {
          "type": "string"
        },
        "clock_state": {
          "type": "string"
        },
        "filesystem": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "managed_policy": {
          "type": "string"
        },
        "os_build": {
          "type": "string"
        },
        "proxy_state": {
          "type": "string"
        },
        "security_product_state": {
          "type": "string"
        },
        "shell": {
          "type": "string"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ring",
        "installer_release_frame_version",
        "installer_release_frame_sha256",
        "ring_manifest_sha256",
        "source_commit",
        "source_tree_sha256",
        "dependency_lock_sha256",
        "catalog_sha256",
        "installer_sha256s"
      ],
      "properties": {
        "ring": {
          "type": "string"
        },
        "installer_release_frame_version": {
          "type": "string"
        },
        "installer_release_frame_sha256": {
          "type": "string"
        },
        "ring_manifest_sha256": {
          "type": "string"
        },
        "source_commit": {
          "type": "string"
        },
        "source_tree_sha256": {
          "type": "string"
        },
        "dependency_lock_sha256": {
          "type": "string"
        },
        "catalog_sha256": {
          "type": "string"
        },
        "installer_sha256s": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "reporting_ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_present",
        "text_sha256",
        "text_bytes",
        "log_count",
        "log_sha256s",
        "instruction_markers_detected",
        "observed_claim_ids",
        "inferred_claim_ids"
      ],
      "properties": {
        "text_present": {
          "type": "boolean"
        },
        "text_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "log_count": {
          "type": "integer",
          "minimum": 0
        },
        "log_sha256s": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "instruction_markers_detected": {
          "type": "boolean"
        },
        "observed_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferred_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "media_type",
          "sha256",
          "bytes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "media_type": {
            "enum": [
              "application/json",
              "text/markdown",
              "text/plain",
              "text/x-log"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000000
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "logical_cwd",
        "input_sha256",
        "before_state_sha256",
        "phase",
        "duration_ms",
        "output_sha256",
        "output_bytes"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logical_cwd": {
          "type": "string"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "before_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "phase": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "created_epoch",
        "received_epoch",
        "ttl_seconds",
        "source_cell_id",
        "source_verified",
        "frame_verified",
        "trust_weight_bps",
        "dedupe_count",
        "rate_window_seconds",
        "rate_count",
        "rate_limit",
        "correlation_id",
        "correlation_disclosed"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_epoch": {
          "type": "integer"
        },
        "received_epoch": {
          "type": "integer"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "source_cell_id": {
          "type": "string"
        },
        "source_verified": {
          "type": "boolean"
        },
        "frame_verified": {
          "type": "boolean"
        },
        "trust_weight_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "dedupe_count": {
          "type": "integer",
          "minimum": 0
        },
        "rate_window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "rate_count": {
          "type": "integer",
          "minimum": 0
        },
        "rate_limit": {
          "type": "integer",
          "minimum": 1
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "correlation_disclosed": {
          "type": "boolean"
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "shard_key_sha256",
        "queue_depth",
        "backpressure_threshold",
        "max_queue_depth",
        "local_raw_retention_seconds",
        "global_raw_data_store",
        "global_lock",
        "global_exchange",
        "hot_cache_hits",
        "negative_cache_hits",
        "fairness_lane",
        "marginal_information_gain_bps"
      ],
      "properties": {
        "cell_id": {
          "type": "string"
        },
        "shard_key_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "queue_depth": {
          "type": "integer",
          "minimum": 0
        },
        "backpressure_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "max_queue_depth": {
          "type": "integer",
          "minimum": 1
        },
        "local_raw_retention_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "global_raw_data_store": {
          "const": false
        },
        "global_lock": {
          "const": false
        },
        "global_exchange": {
          "const": "verified-signatures-frames-aggregate-evidence-only"
        },
        "hot_cache_hits": {
          "type": "integer",
          "minimum": 0
        },
        "negative_cache_hits": {
          "type": "integer",
          "minimum": 0
        },
        "fairness_lane": {
          "enum": [
            "normal",
            "protected",
            "rare"
          ]
        },
        "marginal_information_gain_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    }
  }
}
