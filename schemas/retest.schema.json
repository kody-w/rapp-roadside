{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rapp-roadside:retest:1",
  "title": "RAPP Roadside exact retest result",
  "type": "object",
  "required": [
    "schema",
    "support_system",
    "maintainer_system",
    "machine_issue_artifact",
    "case_id",
    "diagnosis_report_id",
    "status",
    "assertions",
    "replay_manifest",
    "byte_bindings",
    "report_controls",
    "wire_preserved",
    "grail_modified",
    "credentials_collected",
    "external_network_used_by_agent",
    "telemetry",
    "retest_id"
  ],
  "properties": {
    "schema": {
      "const": "rar-installer-troubleshooter/retest-1"
    },
    "support_system": {
      "const": "RAPP Roadside"
    },
    "maintainer_system": {
      "const": "RAPP Pit Crew"
    },
    "machine_issue_artifact": {
      "const": "Roadside Frame"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "assertions": {
      "type": "array",
      "minItems": 1
    },
    "grail_modified": {
      "const": false
    },
    "credentials_collected": {
      "const": false
    },
    "external_network_used_by_agent": {
      "const": false
    },
    "telemetry": {
      "const": false
    }
  }
}
